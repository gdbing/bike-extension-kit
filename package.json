{
  "name": "bike-extension-kit",
  "version": "1.0.0",
  "author": "Hog Bay Software",
  "license": "MIT",
  "description": "",
  "scripts": {
    "new": "node scripts/new.mjs",
    "watch": "node scripts/build-extensions.mjs",
    "build": "node scripts/build-extensions.mjs production",
    "build-internals": "node scripts/build-internals.mjs production",
    "typecheck": "tsc --noEmit --project src/llm-chat.bkext/tsconfig.app.json && tsc --noEmit --project src/llm-chat.bkext/tsconfig.dom.json && tsc --noEmit --project src/llm-chat.bkext/tsconfig.style.json",
    "test:llm-chat": "tsc --project configs/tsconfig.tests.json --outDir out/tests/llm-chat && node out/tests/llm-chat/tests/llm-chat/run-tests.js && python3 src/llm-chat.bkext/proxy/providers_test.py",
    "test:inlining": "tsc --project configs/tsconfig.inlining-tests.json --outDir out/tests/inlining && node out/tests/inlining/tests/inlining/run-tests.js"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "ajv": "^8.17.1",
    "d3": "^7.9.0",
    "esbuild": "0.25.4",
    "esbuild-plugin-external-global": "^1.0.1",
    "fast-glob": "^3.3.3",
    "react": "^19.1.0",
    "react-calendar": "^5.1.0",
    "react-dom": "^19.1.0",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5"
  }
}
